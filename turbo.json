{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "**/.env",
    "**/.env.*",
    "eslint.config.mjs",
    "tooling/**",
    "tsconfig*.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "public/sw.js",
        "public/sw.js.map",
        "public/swe-worker-*.js",
        "public/swe-worker-*.js.map"
      ],
      "env": ["NEXT_PUBLIC_*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "api#db:generate": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "api#build": {
      "dependsOn": ["^build", "api#db:generate"],
      "outputs": ["dist/**"]
    },
    "api#typecheck": {
      "dependsOn": ["^typecheck", "api#db:generate"]
    },
    "api#test": {
      "dependsOn": ["^build", "api#db:generate"]
    },
    "api#dev": {
      "dependsOn": ["api#db:generate"],
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": ["NODE_ENV"]
}
