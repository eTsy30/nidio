generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  firstName              String                  @db.VarChar(50)
  avatarUrl              String?
  gender                 Gender                  @default(UNSPECIFIED)
  emailVerifiedAt        DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  timeZone               String?
  memberships            CoupleMember?
  emailVerifications     EmailVerification[]
  createdEvents          Event[]                 @relation("CreatedEvents")
  personalEvents         Event[]                 @relation("PersonalEvents")
  createdInvites         Invite[]
  passwordResets         PasswordReset[]
  pushSubscriptions      PushSubscription[]
  refreshTokens          RefreshToken[]
  scheduledNotifications ScheduledNotification[]
  createdTemplates       Template[]              @relation("CreatedTemplates")
  workspaces             Workspace[]
}

model Couple {
  id                    String                 @id @default(cuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  relationshipAt        DateTime?
  notificationDirty     Boolean                @default(true)
  board                 Board?
  members               CoupleMember[]
  events                Event[]
  invites               Invite[]
  savingsGoals          SavingsGoal[]
  loyaltyCards          LoyaltyCard[]
  financialTransactions FinancialTransaction[]
  budgetLimits          BudgetLimit[]
  templates             Template[]
  workspace             Workspace?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([notificationDirty])
}

model CoupleMember {
  savingsColor String?
  id       String   @id @default(cuid())
  coupleId String
  userId   String   @unique
  joinedAt DateTime @default(now())
  couple   Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coupleId, userId])
  @@index([coupleId])
}

model Invite {
  id         String       @id @default(cuid())
  token      String       @unique
  coupleId   String?
  creatorId  String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  status     InviteStatus @default(PENDING)
  couple     Couple?      @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  creator    User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([coupleId])
  @@index([creatorId])
  @@index([token])
}

model Board {
  id        String   @id @default(cuid())
  coupleId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  columns   Column[]

  @@index([coupleId])
}

model Column {
  id        String   @id @default(cuid())
  boardId   String
  title     String   @db.VarChar(100)
  icon      String?
  color     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId])
  @@index([order])
}

model Template {
  id          String         @id @default(cuid())
  title       String         @db.VarChar(100)
  icon        String?
  color       String?
  isSystem    Boolean        @default(false)
  coupleId    String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  couple      Couple?        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user        User?          @relation("CreatedTemplates", fields: [createdById], references: [id])
  items       TemplateItem[]

  @@index([coupleId])
  @@index([isSystem])
}

model TemplateItem {
  id           String       @id @default(cuid())
  templateId   String
  title        String
  assigneeMode AssigneeMode @default(ME)
  repeat       Repeat       @default(NONE)
  order        Int          @default(0)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([order])
}

model Task {
  id                      String           @id @default(cuid())
  title                   String
  description             String?
  assigneeId              String?
  coupleId                String?
  dueAt                   DateTime?
  repeat                  Repeat           @default(NONE)
  completed               Boolean          @default(false)
  completedAt             DateTime?
  createdById             String
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  assigneeMode            AssigneeMode     @default(ME)
  occurrenceIndex         Int              @default(0)
  recurringGroupId        String?
  repeatConfig            Json?
  repeatUntil             DateTime?
  rotationFirstAssigneeId String?
  columnId                String
  order                   Int              @default(0)
  priority                Boolean          @default(false)
  overdueNotifiedAt       DateTime?
  nudges                  Nudge[]
  column                  Column           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  completions             TaskCompletion[]

  @@index([completed, overdueNotifiedAt, dueAt])
  @@index([columnId])
  @@index([coupleId])
  @@index([assigneeId])
  @@index([dueAt])
  @@index([completed])
  @@index([order])
  @@index([priority])
  @@index([recurringGroupId])
}

model TaskCompletion {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
}

model Nudge {
  id          String   @id @default(cuid())
  taskId      String
  senderId    String
  recipientId String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([recipientId])
  @@index([createdAt])
}

model Workspace {
  id        String        @id @default(cuid())
  type      WorkspaceType
  title     String        @db.VarChar(100)
  userId    String?
  coupleId  String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  spaces    Space[]
  couple    Couple?       @relation(fields: [coupleId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Space {
  id          String    @id @default(cuid())
  workspaceId String
  title       String    @db.VarChar(100)
  icon        String?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  blocks      Block[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Block {
  id        String    @id @default(cuid())
  spaceId   String
  type      BlockType
  position  Int
  content   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

model Event {
  id                String      @id @default(cuid())
  title             String      @db.VarChar(200)
  description       String?
  startAt           DateTime
  endAt             DateTime?
  type              EventType   @default(OTHER)
  scope             EventScope
  createdById       String
  userId            String?
  coupleId          String?
  reminderAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  allDay            Boolean     @default(false)
  repeat            EventRepeat @default(NONE)
  excludedDates     DateTime[]
  repeatUntil       DateTime?
  timeZone          String?
  notificationDirty Boolean     @default(true)
  couple            Couple?     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy         User        @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: Cascade)
  user              User?       @relation("PersonalEvents", fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationDirty])
  @@index([userId, startAt])
  @@index([coupleId, startAt])
  @@index([createdById])
  @@index([startAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, expiresAt])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  jti       String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id                   String                @id @default(cuid())
  userId               String
  endpoint             String                @unique
  p256dh               String
  auth                 String
  createdAt            DateTime              @default(now())
  notificationAttempts NotificationAttempt[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model ScheduledNotification {
  id            String    @id @default(cuid())
  key           String    @unique
  kind          String
  sourceId      String
  userId        String
  coupleId      String?
  runAt         DateTime
  occurrenceAt  DateTime?
  sourceVersion DateTime?
  payload       Json
  leaseUntil    DateTime  @default(dbgenerated("'1970-01-01 00:00:00'::timestamp without time zone"))
  leaseToken    String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([runAt, leaseUntil])
  @@index([sourceId])
}

model NotificationAttempt {
  subscriptionId String
  key            String
  createdAt      DateTime         @default(now())
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([subscriptionId, key])
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Repeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum AssigneeMode {
  ME
  PARTNER
  BOTH
  ROTATE
}

enum WorkspaceType {
  PERSONAL
  COUPLE
}

enum BlockType {
  TEXT
  CHECKLIST
  LINK
  IMAGE
  QUOTE
  DIVIDER
}

enum EventRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum EventType {
  DATE
  BIRTHDAY
  ANNIVERSARY
  OTHER
}

enum EventScope {
  PERSONAL
  COUPLE
}

model SavingsGoal {
  strategy     String @default("FREE")
  gridOrder    String @default("ASC")
  scheduleEvery String?
  scheduleAmountMinor Int?
  scheduleStartDate String?
  ownerId      String?
  scope        String @default("COUPLE")
  plan         Json @default("[]")
  achievements Json @default("[]")
  archived     Boolean @default(false)
  id           String               @id @default(cuid())
  coupleId     String
  title        String               @db.VarChar(100)
  description  String               @default("")
  targetMinor  Int
  currency     String               @db.VarChar(3)
  icon         String               @default("🎯")
  color        String               @default("primary")
  targetDate   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  couple       Couple               @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  transactions SavingsTransaction[]

  @@index([coupleId])
}

model SavingsTransaction {
  stepId      String?
  cancelledAt DateTime?
  id          String      @id @default(cuid())
  goalId      String
  requestId   String
  amountMinor Int
  type        String
  createdBy   String
  description String      @default("")
  createdAt   DateTime    @default(now())
  goal        SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, requestId])
}

model LoyaltyCard {
  id            String    @id @default(cuid())
  coupleId      String
  storeName     String    @db.VarChar(100)
  cardNumber    String    @db.VarChar(256)
  barcodeFormat String    @default("NONE")
  category      String
  comment       String    @default("")
  color         String    @default("primary")
  imageKey      String?
  isFavorite    Boolean   @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  couple        Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  coupleId    String
  requestId   String
  amountMinor Int
  currency    String   @db.VarChar(3)
  type        String
  category    String
  date        String   @db.VarChar(10)
  description String   @default("")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([coupleId, requestId])
  @@index([coupleId, date])
}

model BudgetLimit {
  id          String   @id @default(cuid())
  coupleId    String
  currency    String   @db.VarChar(3)
  category    String
  month       String   @db.VarChar(7)
  amountMinor Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([coupleId, currency, category, month])
}
