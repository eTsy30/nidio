generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========  User & Auth  ==========

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  firstName          String              @db.VarChar(50)
  avatarUrl          String?
  gender             Gender              @default(UNSPECIFIED)
  emailVerifiedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  pushSubscriptions  PushSubscription[]
  chatPresence       ChatPresence[]
  memberships        CoupleMember[]
  emailVerifications EmailVerification[]
  createdInvites     Invite[]
  messages           Message[]
  messageReactions   MessageReaction[]
  passwordResets     PasswordReset[]
  refreshTokens      RefreshToken[]
  workspaces         Workspace[]
  createdEvents      Event[]             @relation("CreatedEvents")
  personalEvents     Event[]             @relation("PersonalEvents")
  createdTemplates   Template[]          @relation("CreatedTemplates")
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

// ==========  Couple & Relationship  ==========

model Couple {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  relationshipAt DateTime?

  members   CoupleMember[]
  invites   Invite[]
  workspace Workspace?
  events    Event[]
  board     Board?
  templates Template[]

  @@index([createdAt])
  @@index([deletedAt])
}

model CoupleMember {
  id       String   @id @default(cuid())
  coupleId String
  userId   String   @unique
  joinedAt DateTime @default(now())
  couple   Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coupleId, userId])
  @@index([coupleId])
}

model Invite {
  id         String       @id @default(cuid())
  token      String       @unique
  coupleId   String?
  creatorId  String
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  couple     Couple?      @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  creator    User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([coupleId])
  @@index([creatorId])
  @@index([token])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ==========  Board & Columns (NEW)  ==========

model Board {
  id        String   @id @default(cuid())
  coupleId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  columns   Column[]
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

model Column {
  id        String   @id @default(cuid())
  boardId   String
  title     String   @db.VarChar(100)
  icon      String? // lucide icon name или emoji
  color     String? // hex цвет, назначается автоматически
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId])
  @@index([order])
}

// ==========  Templates (NEW)  ==========

model Template {
  id          String         @id @default(cuid())
  title       String         @db.VarChar(100)
  icon        String?
  color       String?
  isSystem    Boolean        @default(false)
  coupleId    String? // для пользовательских шаблонов пары
  createdById String? // кто создал пользовательский шаблон
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       TemplateItem[]

  couple Couple? @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User?   @relation("CreatedTemplates", fields: [createdById], references: [id])

  @@index([coupleId])
  @@index([isSystem])
}

model TemplateItem {
  id           String       @id @default(cuid())
  templateId   String
  title        String
  assigneeMode AssigneeMode @default(ME)
  repeat       Repeat       @default(NONE)
  order        Int          @default(0)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([order])
}

// ==========  Task (UPDATED)  ==========

enum Repeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum AssigneeMode {
  ME
  PARTNER
  BOTH
  ROTATE
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  coupleId String?
  order    Int     @default(0)
  priority Boolean @default(false)

  assigneeId              String?
  assigneeMode            AssigneeMode @default(ME)
  rotationFirstAssigneeId String?

  dueAt        DateTime?
  repeat       Repeat    @default(NONE)
  repeatUntil  DateTime?
  repeatConfig Json?

  recurringGroupId String?
  occurrenceIndex  Int     @default(0)

  completed   Boolean   @default(false)
  completedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  completions TaskCompletion[]
  nudges      Nudge[]

  @@index([columnId])
  @@index([coupleId])
  @@index([assigneeId])
  @@index([dueAt])
  @@index([completed])
  @@index([order])
  @@index([priority])
  @@index([recurringGroupId])
}

model TaskCompletion {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
}

model Nudge {
  id          String   @id @default(cuid())
  taskId      String
  senderId    String
  recipientId String
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([recipientId])
  @@index([createdAt])
}

// ==========  Workspace & Chat  ==========

model Workspace {
  id        String        @id @default(cuid())
  type      WorkspaceType
  title     String        @db.VarChar(100)
  userId    String?
  coupleId  String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  Message[]
  spaces    Space[]
  couple    Couple?       @relation(fields: [coupleId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum WorkspaceType {
  PERSONAL
  COUPLE
}

// ==========  Chat  ==========

model Message {
  id String @id @default(cuid())

  workspaceId String
  senderId    String
  type        MessageType @default(TEXT)
  content     String?     @db.Text
  clientId    String?     @unique
  metadata    Json?
  replyToId   String?
  deliveredAt DateTime?
  readAt      DateTime?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sender    User      @relation(fields: [senderId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  replyTo Message?  @relation("MessageReply", fields: [replyToId], references: [id])
  replies Message[] @relation("MessageReply")

  pushDeliveries PushDelivery[]
  attachments MessageAttachment[]
  reactions   MessageReaction[]

  @@index([workspaceId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([clientId])
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String

  type AttachmentType

  url      String
  mimeType String
  fileName String?
  fileSize Int
  width    Int?
  height   Int?
  duration Int?

  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReaction {
  id        String @id @default(cuid())
  messageId String
  userId    String

  emoji String @db.VarChar(20)

  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum AttachmentType {
  IMAGE
  VIDEO
  VOICE
  FILE
}

// ==========  Space & Block  ==========

model Space {
  id          String    @id @default(cuid())
  workspaceId String
  title       String    @db.VarChar(100)
  icon        String?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  blocks      Block[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Block {
  id        String    @id @default(cuid())
  spaceId   String
  type      BlockType
  position  Int
  content   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

enum BlockType {
  TEXT
  CHECKLIST
  LINK
  IMAGE
  QUOTE
  DIVIDER
}

// ==========  Event  ==========

model Event {
  id          String      @id @default(cuid())
  title       String      @db.VarChar(200)
  description String?     @db.Text
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean     @default(false)
  repeat      EventRepeat @default(NONE)
  type        EventType   @default(OTHER)
  scope       EventScope

  createdById String
  createdBy   User   @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("PersonalEvents", fields: [userId], references: [id], onDelete: Cascade)

  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  reminderAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  repeatUntil   DateTime?
  excludedDates DateTime[]

  @@index([userId, startAt])
  @@index([coupleId, startAt])
  @@index([createdById])
  @@index([startAt])
}

enum EventRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum EventType {
  DATE
  BIRTHDAY
  ANNIVERSARY
  OTHER
}

enum EventScope {
  PERSONAL
  COUPLE
}

// ==========  Auth helpers  ==========

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, expiresAt])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String @id @default(cuid())
  userId    String
  endpoint  String @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@index([userId])
}

model PushDelivery {
  subscriptionId String
  messageId String
  createdAt DateTime @default(now())
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@id([subscriptionId, messageId])
}

model ChatPresence {
  socketId String @id
  userId String
  workspaceId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, workspaceId, expiresAt])
}
